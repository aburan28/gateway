diff --git a/topazd/authorizer/impl/jwt.go b/topazd/authorizer/impl/jwt.go
index b6b5042..ee1f83c 100644
--- a/topazd/authorizer/impl/jwt.go
+++ b/topazd/authorizer/impl/jwt.go
@@ -4,9 +4,11 @@ import (
 	"context"
 	"encoding/json"
 	"fmt"
+	"net"
 	"net/http"
 	"net/url"
 	"path"
+	"strings"
 	"time"
 
 	"github.com/aserto-dev/go-authorizer/aserto/authorizer/v2/api"
@@ -24,7 +26,16 @@ import (
 	"google.golang.org/protobuf/proto"
 )
 
-const jwtMinRefreshInterval = 15 * time.Minute
+const (
+	jwtMinRefreshInterval = 15 * time.Minute
+	jwksFetchTimeout      = 10 * time.Second
+	jwksMaxResponseBytes  = 256 * 1024
+)
+
+// ErrIssuerNotAllowed is returned when a JWT's `iss` claim is not in the
+// configured allow-list. We do not perform any network call (e.g. JWKS
+// fetch) until this check has passed.
+var ErrIssuerNotAllowed = aerr.ErrAuthenticationFailed.Msg("jwt issuer not allowed")
 
 var (
 	// ErrMissingMetadata - metadata element missing.
@@ -62,6 +73,15 @@ func (s *AuthorizerServer) getIdentityFromJWT(ctx context.Context, bearerJWT str
 		return "", err
 	}
 
+	// Reject unknown issuers before any network call. Without this check, a
+	// caller-supplied JWT could (a) cause the authorizer to issue HTTP requests
+	// to an attacker-chosen host (SSRF) and (b) spoof any identity once the
+	// attacker-controlled JWKS is trusted.
+	if err := s.validateIssuer(jwtTemp.Issuer()); err != nil {
+		log.Warn().Str("issuer", jwtTemp.Issuer()).Msg("rejected jwt with disallowed issuer")
+		return "", err
+	}
+
 	options, err := s.jwtParseStringOptions(ctx, jwtTemp)
 	if err != nil {
 		return "", err
@@ -141,7 +161,100 @@ func (s *AuthorizerServer) jwksURLFromCache(ctx context.Context, issuer string)
 	return jwksURL, nil
 }
 
-// jwksURL.
+// validateIssuer enforces that the JWT issuer is in the configured allow-list.
+// The list is compared as exact-match strings on the canonical issuer claim.
+func (s *AuthorizerServer) validateIssuer(issuer string) error {
+	if issuer == "" {
+		return ErrIssuerNotAllowed
+	}
+
+	allowed := s.cfg.JWT.AllowedIssuers
+	if len(allowed) == 0 {
+		// Empty allow-list = JWT identities disabled. Fail closed.
+		return ErrIssuerNotAllowed
+	}
+
+	for _, a := range allowed {
+		if a == issuer {
+			return nil
+		}
+	}
+
+	return ErrIssuerNotAllowed
+}
+
+// safeJWKSClient returns an HTTP client suitable for fetching well-known
+// metadata and JWK sets. It enforces a request timeout, refuses redirects to
+// hosts that resolve only to private/loopback/link-local IPs, and rejects
+// non-HTTPS schemes on every redirect hop.
+func safeJWKSClient() *http.Client {
+	dialer := &net.Dialer{Timeout: jwksFetchTimeout}
+
+	transport := &http.Transport{
+		// DialContext enforces address-based filtering at connect time as a
+		// last line of defense against DNS rebinding.
+		DialContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			host, port, err := net.SplitHostPort(addr)
+			if err != nil {
+				return nil, err
+			}
+
+			ips, err := net.DefaultResolver.LookupIP(ctx, "ip", host)
+			if err != nil {
+				return nil, err
+			}
+
+			for _, ip := range ips {
+				if isPrivateOrLocalIP(ip) {
+					return nil, fmt.Errorf("refusing to connect to non-public address %s", ip.String())
+				}
+			}
+
+			return dialer.DialContext(ctx, network, net.JoinHostPort(host, port))
+		},
+	}
+
+	return &http.Client{
+		Timeout:   jwksFetchTimeout,
+		Transport: transport,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			if len(via) >= 3 {
+				return errors.New("too many redirects")
+			}
+
+			if !strings.EqualFold(req.URL.Scheme, "https") {
+				return fmt.Errorf("refusing redirect to non-https scheme %q", req.URL.Scheme)
+			}
+
+			return nil
+		},
+	}
+}
+
+// isPrivateOrLocalIP returns true if the address is loopback, link-local,
+// multicast, unspecified, or in a private range (RFC 1918, RFC 4193).
+func isPrivateOrLocalIP(ip net.IP) bool {
+	if ip == nil {
+		return true
+	}
+
+	if ip.IsLoopback() || ip.IsLinkLocalUnicast() || ip.IsLinkLocalMulticast() ||
+		ip.IsInterfaceLocalMulticast() || ip.IsMulticast() || ip.IsUnspecified() {
+		return true
+	}
+
+	if ip.IsPrivate() {
+		return true
+	}
+
+	return false
+}
+
+// jwksURL discovers the JWKS endpoint for an issuer. The issuer string has
+// already been allow-listed by validateIssuer; the function additionally
+// enforces https-only, rejects private/loopback hosts, and refuses to follow
+// a `jwks_uri` returned by .well-known/openid-configuration whose host
+// differs from the issuer's host.
 func (s *AuthorizerServer) jwksURL(ctx context.Context, baseURL string) (*url.URL, error) {
 	const (
 		wellknownConfig = `.well-known/openid-configuration`
@@ -153,11 +266,16 @@ func (s *AuthorizerServer) jwksURL(ctx context.Context, baseURL string) (*url.UR
 		return nil, err
 	}
 
-	if u.Scheme == "" {
-		return nil, errors.New("no scheme defined for baseURL")
+	if !strings.EqualFold(u.Scheme, "https") {
+		return nil, errors.Errorf("issuer must use https scheme, got %q", u.Scheme)
+	}
+
+	if u.Host == "" {
+		return nil, errors.New("issuer has no host")
 	}
 
 	originalPath := u.Path
+	issuerHost := u.Host
 	u.Path = path.Join(originalPath, wellknownConfig)
 
 	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), http.NoBody)
@@ -165,23 +283,43 @@ func (s *AuthorizerServer) jwksURL(ctx context.Context, baseURL string) (*url.UR
 		return nil, err
 	}
 
-	client := &http.Client{}
+	client := safeJWKSClient()
 
 	resp, err := client.Do(req)
 	if err == nil {
 		defer func() { _ = resp.Body.Close() }()
 
-		var config struct {
-			URI string `json:"jwks_uri"`
-		}
+		if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+			var config struct {
+				URI string `json:"jwks_uri"`
+			}
 
-		if err := json.NewDecoder(resp.Body).Decode(&config); err == nil {
-			if u, err = url.Parse(config.URI); err == nil {
-				return u, nil
+			limited := http.MaxBytesReader(nil, resp.Body, jwksMaxResponseBytes)
+
+			if err := json.NewDecoder(limited).Decode(&config); err == nil {
+				if discovered, err := url.Parse(config.URI); err == nil {
+					if !strings.EqualFold(discovered.Scheme, "https") {
+						return nil, errors.Errorf("discovered jwks_uri must use https, got %q", discovered.Scheme)
+					}
+
+					// The well-known endpoint trusted the issuer; pin the
+					// discovered URI to the same host so a compromised
+					// endpoint can't redirect us elsewhere.
+					if !strings.EqualFold(discovered.Host, issuerHost) {
+						return nil, errors.Errorf(
+							"discovered jwks_uri host %q does not match issuer host %q",
+							discovered.Host, issuerHost,
+						)
+					}
+
+					return discovered, nil
+				}
 			}
 		}
 	}
 
+	// Fall back to issuer/.well-known/jwks.json. The issuer URL has already
+	// been allow-listed and verified to be https.
 	u.Path = path.Join(originalPath, wellknownJWKS)
 
 	return u, nil
-- 
