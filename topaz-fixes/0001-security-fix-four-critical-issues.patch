From 31ef8f02a9f351ee962b55e75e580d79926795d8 Mon Sep 17 00:00:00 2001
From: Topaz Security Review <security-review@local>
Date: Sat, 16 May 2026 04:03:23 +0000
Subject: [PATCH] security: fix four critical issues found in security review

C1: /api/v1/authorizers no longer returns the configured API key to
    anonymous callers. The endpoint is now wrapped with the same
    ConfigAuth middleware as /api/v2/config, and the handler gates
    the apiKey field on the AuthenticatedUser context value.

C2: The service no longer silently turns anonymous when an operator
    omits auth.keys. The config validator now refuses to start unless
    either api keys are configured OR auth.options.default.enable_anonymous
    is explicitly set to true. The default-anonymous code path emits
    a WARN log on every startup.

C3: pkg/config/schema/config.yaml no longer ships with two
    plausible-looking API keys. They have been replaced with an empty
    list and a comment instructing operators to generate their own.

C4: JWT identity acceptance no longer trusts the unverified iss claim
    to drive a network fetch. A new jwt.allowed_issuers config list pins
    the set of acceptable issuers; tokens with any other issuer are
    rejected before any HTTP call. The JWKS fetch path additionally:
      - requires https on both the issuer URL and any discovered jwks_uri
      - refuses connections to private/loopback/link-local addresses
      - applies a 10s timeout to the http.Client and limits responses
        to 256 KiB
      - caps redirects at 3 and refuses non-https redirect hops
      - pins the discovered jwks_uri host to the issuer host
---
 pkg/config/config.go              |   7 ++
 pkg/config/schema/config.yaml     |   9 +-
 pkg/config/topaz_config.go        |  16 ++-
 topazd/app/handlers/authorizer.go |  17 +++-
 topazd/app/topaz.go               |   2 +-
 topazd/authorizer/impl/jwt.go     | 160 ++++++++++++++++++++++++++++--
 6 files changed, 189 insertions(+), 22 deletions(-)

diff --git a/pkg/config/config.go b/pkg/config/config.go
index c179f33..bcadbdf 100644
--- a/pkg/config/config.go
+++ b/pkg/config/config.go
@@ -56,6 +56,13 @@ type Common struct {
 		// Specifies the duration in which exp (Expiry) and nbf (Not Before)
 		// claims may differ by. This value should be positive.
 		AcceptableTimeSkewSeconds int `json:"acceptable_time_skew_seconds"`
+		// AllowedIssuers is the list of JWT issuers (the `iss` claim) that the
+		// authorizer will accept. The issuer is checked BEFORE any network call
+		// to fetch JWKS, so an attacker cannot use an unverified `iss` to
+		// pivot to internal HTTP endpoints (SSRF) or to spoof an identity by
+		// hosting their own JWKS. When the list is empty, JWT identities are
+		// rejected.
+		AllowedIssuers []string `json:"allowed_issuers"`
 	} `json:"jwt"`
 
 	// Directory configuration
diff --git a/pkg/config/schema/config.yaml b/pkg/config/schema/config.yaml
index ef16742..92ecdb8 100644
--- a/pkg/config/schema/config.yaml
+++ b/pkg/config/schema/config.yaml
@@ -39,10 +39,13 @@ jwt:
   acceptable_time_skew_seconds: 5 # set as default, 5 secs
 
 # authentication configuration
+#
+# Generate API keys with: openssl rand -hex 32
+# Do NOT use the placeholder strings below in production.
 auth:
-  keys:
-    - "69ba614c64ed4be69485de73d062a00b"
-    - "##Ve@rySecret123!!"
+  keys: []
+    # - "<API key 1>"
+    # - "<API key 2>"
   options:
     default:
       enable_api_key: true
diff --git a/pkg/config/topaz_config.go b/pkg/config/topaz_config.go
index 210dffb..8b9e365 100644
--- a/pkg/config/topaz_config.go
+++ b/pkg/config/topaz_config.go
@@ -102,10 +102,20 @@ func (c *Config) validation() error {
 	setDefaultCallsAuthz(c)
 	c.Auth.transposeKeys()
 
-	if len(c.Auth.APIKeys) > 0 {
+	switch {
+	case len(c.Auth.APIKeys) > 0:
 		c.Auth.Options.Default.EnableAPIKey = true
-	} else {
-		c.Auth.Options.Default.EnableAnonymous = true
+	case c.Auth.Options.Default.EnableAnonymous:
+		// Operator has explicitly opted in to anonymous access.
+		log.Warn().Msg("auth: anonymous access enabled — every API caller is unauthenticated")
+	default:
+		// Fail closed: an authorization service must not silently turn anonymous
+		// when an operator forgets to configure keys. Require an explicit choice.
+		return errors.New(
+			"auth: no api keys configured and auth.options.default.enable_anonymous is not set; " +
+				"refusing to start. Set auth.keys to a list of API keys, or explicitly set " +
+				"auth.options.default.enable_anonymous: true to allow unauthenticated access.",
+		)
 	}
 
 	return nil
